diff --git a/src/mesa/util/os_misc.c b/src/mesa/util/os_misc.c
--- a/src/mesa/util/os_misc.c
+++ b/src/mesa/util/os_misc.c
@@ -55,8 +55,27 @@
 #if DETECT_OS_ANDROID
 #  define LOG_TAG "MESA"
 #  include <unistd.h>
-#  include <log/log.h>
-#  include <cutils/properties.h>
+#  include <android/log.h>
+#  define LOG_PRI(priority, tag, ...) __android_log_print(priority, tag, __VA_ARGS__)
+#  ifndef PROPERTY_VALUE_MAX
+#    define PROPERTY_VALUE_MAX 92
+#  endif
+#  ifndef PROPERTY_KEY_MAX
+#    define PROPERTY_KEY_MAX 32
+#  endif
+static inline int property_get(const char *key, char *value,
+                               const char *default_value)
+{
+   (void) key;
+   if (default_value) {
+      size_t len = strlcpy(value, default_value, PROPERTY_VALUE_MAX);
+      return len < PROPERTY_VALUE_MAX ? (int)len : PROPERTY_VALUE_MAX - 1;
+   }
+   if (value) {
+      value[0] = '\0';
+   }
+   return 0;
+}
 #elif DETECT_OS_LINUX || DETECT_OS_CYGWIN || DETECT_OS_SOLARIS || DETECT_OS_HURD
 #  include <unistd.h>
